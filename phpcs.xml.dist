<?xml version="1.0"?>
<ruleset name="SES Abogados">
	<description>
		Ruleset de WordPress Coding Standards para el tema SES Abogados.
		Requiere PHP + Composer instalados (no disponibles en este entorno
		de trabajo) — instalar con:
		composer require --dev wp-coding-standards/wpcs squizlabs/php_codesniffer
		y ejecutar con: vendor/bin/phpcs
	</description>

	<file>.</file>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/acf-json/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress">
		<!--
			El proyecto usa camelCase en variables locales de theme.json
			indirectamente y prefijo ses_ propio; se ajusta severidad de
			reglas puramente estilísticas si generan ruido excesivo, no se
			desactiva seguridad/escapado.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ses-abogados"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array"/>
		</properties>
	</rule>
</ruleset>
